<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema de Gestión de Trabajos de Grado - Maestría en Ingeniería UQ</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    body { 
      font-family: 'Inter', sans-serif; 
      background-color: #f1f5f9;
    }
    
    .glass-card {
      background-color: #ffffff;
      border: 1px solid #cbd5e1;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .header-uq {
      background-color: #065f46;
    }

    .banner-uq {
      background-color: #022c22;
      color: #ffffff;
    }

    .input-custom {
      background-color: #f8fafc;
      border: 1px solid #94a3b8;
      color: #0f172a;
    }

    .input-custom:focus {
      outline: none;
      background-color: #ffffff;
      border-color: #15803d;
      box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.2);
    }

    .btn-green {
      background-color: #15803d !important;
      color: #ffffff !important;
    }
    
    .btn-green:hover {
      background-color: #166534 !important;
    }

    .badge-status {
      background-color: #064e3b;
      color: #fef08a;
      border: 1px solid #15803d;
    }

    .deadline-box {
      background-color: #064e3b;
      color: #ffffff;
      border: 1px solid #15803d;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Encabezado Principal -->
  <header class="header-uq text-white shadow-xl relative z-10">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-4">
        <div class="bg-green-800 p-3 rounded-2xl border border-green-600">
          <i class="fa-solid fa-graduation-cap text-3xl text-yellow-300"></i>
        </div>
        <div>
          <h1 class="text-2xl font-black tracking-tight text-white">Gestión de Trabajos de Grado</h1>
          <p class="text-xs text-green-200 font-medium">Maestría en Ingeniería — Universidad del Quindío</p>
        </div>
      </div>
      <div id="sessionArea" class="flex items-center space-x-3 bg-green-800 px-4 py-2 rounded-xl border border-green-600 text-xs text-white"></div>
    </div>
  </header>

  <!-- Banner de Estado y Plazo (Texto Blanco sobre Fondo Oscuro con Contraste Total) -->
  <section class="banner-uq py-2.5 px-6 shadow-md border-b border-green-900">
    <div class="max-w-7xl mx-auto text-xs flex flex-col sm:flex-row justify-between items-center gap-3">
      <span id="roleBadge" class="badge-status font-bold px-3.5 py-1 rounded-full uppercase tracking-wider text-[11px] flex items-center gap-2">
        <i class="fa-solid fa-circle-user text-yellow-400"></i> Estado: No autenticado
      </span>
      <div id="deadlineBanner" class="deadline-box flex items-center space-x-2 px-4 py-1.5 rounded-xl">
        <i class="fa-solid fa-clock text-yellow-400"></i>
        <span class="text-white font-medium">Plazo Oficial de Entrega: <strong id="deadlineDisplay" class="font-bold text-yellow-300">Sin definir</strong></span>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex-grow w-full">

    <!-- TARJETA DE AUTENTICACIÓN / REGISTRO / RECUPERACIÓN -->
    <div id="authSection" class="max-w-md mx-auto glass-card rounded-3xl p-8 mb-8">
      
      <!-- Pestañas de Navegación -->
      <div id="authTabs" class="flex border-b border-gray-300 mb-6 text-center text-sm font-bold">
        <button id="tabLogin" type="button" onclick="switchAuthTab('login')" class="w-1/2 py-2.5 border-b-2 border-green-700 text-green-800 font-extrabold focus:outline-none">Iniciar Sesión</button>
        <button id="tabRegister" type="button" onclick="switchAuthTab('register')" class="w-1/2 py-2.5 border-b-2 border-transparent text-gray-500 hover:text-green-700 font-bold focus:outline-none">Registrarse</button>
      </div>

      <!-- Formulario Iniciar Sesión -->
      <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1.5">Nombre de Usuario o Correo</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-500"><i class="fa-solid fa-user text-xs"></i></span>
            <input type="text" id="loginUser" required class="w-full text-sm rounded-xl pl-9 pr-3.5 py-2.5 input-custom" placeholder="Ej: Jorgito o usuario@uniquindio.edu.co">
          </div>
        </div>
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label class="block text-xs font-bold text-gray-700">Contraseña</label>
            <a href="#" onclick="switchAuthTab('forgot')" class="text-[11px] text-green-700 hover:text-green-900 hover:underline font-bold">¿Olvidaste tu contraseña?</a>
          </div>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-500"><i class="fa-solid fa-lock text-xs"></i></span>
            <input type="password" id="loginPassword" required class="w-full text-sm rounded-xl pl-9 pr-3.5 py-2.5 input-custom" placeholder="••••••••">
          </div>
        </div>
        <button type="submit" class="w-full btn-green font-bold text-sm py-3 rounded-xl shadow-md flex items-center justify-center gap-2">
          <i class="fa-solid fa-right-to-bracket text-white"></i> Ingresar al Sistema
        </button>
      </form>

      <!-- Formulario Registro -->
      <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-3.5 hidden">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Nombre Completo:</label>
          <input type="text" id="regName" required class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom" placeholder="Jorge Aldana">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Nombre de Usuario:</label>
          <input type="text" id="regUsername" required class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom" placeholder="Jorgito">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Correo Electrónico:</label>
          <input type="email" id="regEmail" required class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom" placeholder="ejemplo@uniquindio.edu.co">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Contraseña:</label>
          <input type="password" id="regPassword" required minlength="4" class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom" placeholder="Mínimo 4 caracteres">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Asignar Rol Académico:</label>
          <select id="regRole" required class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom bg-white font-medium">
            <option value="estudiante">👨‍🎓 Estudiante (Autor de Proyecto)</option>
            <option value="director">👨‍🏫 Director</option>
            <option value="jurado">⚖️ Jurado</option>
            <option value="coordinador">🏛️ Coordinador de Énfasis</option>
          </select>
        </div>
        <button type="submit" class="w-full btn-green font-bold text-sm py-3 rounded-xl shadow-md flex justify-center items-center gap-2">
          <i class="fa-solid fa-user-plus text-white"></i> Registrar Cuenta
        </button>
      </form>

      <!-- Módulo de Recuperación -->
      <div id="forgotFormContainer" class="hidden space-y-4">
        <div class="text-center mb-2">
          <h3 class="text-sm font-bold text-gray-800">Recuperación de Contraseña</h3>
          <p class="text-xs text-gray-500 mt-0.5">Ingresa tu correo o usuario para solicitar el código de verificación.</p>
        </div>

        <form id="sendCodeForm" onsubmit="handleSendCode(event)" class="space-y-3">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Correo o Usuario Registrado:</label>
            <input type="text" id="resetAccountInput" required class="w-full text-sm rounded-xl px-3.5 py-2.5 input-custom" placeholder="ejemplo@uniquindio.edu.co o Jorgito">
          </div>
          <button type="submit" class="w-full btn-green font-bold text-xs py-2.5 rounded-xl shadow">
            <i class="fa-solid fa-paper-plane mr-1.5 text-white"></i> Solicitar Código de Verificación
          </button>
        </form>

        <div id="codeNotification" class="hidden bg-yellow-100 border border-yellow-400 rounded-2xl p-4 text-xs text-yellow-900 space-y-2">
          <p class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-envelope-circle-check text-amber-700 text-sm"></i> Código Enviado al Correo:</p>
          <p class="text-gray-700">Destinatario: <span id="targetEmailDisplay" class="font-mono font-bold text-gray-900"></span></p>
          <div class="bg-white p-2.5 rounded-xl font-mono font-black text-center border border-amber-300 text-xl text-green-800 tracking-widest shadow-inner" id="generatedCodeDisplay"></div>
          <p class="text-[10px] text-gray-600 italic text-center">Ingresa este código exacto de 6 dígitos abajo para restablecer la contraseña.</p>
        </div>

        <form id="verifyCodeForm" onsubmit="handleResetPassword(event)" class="space-y-3 hidden border-t pt-3.5 border-gray-200">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Código de Verificación (6 dígitos):</label>
            <input type="text" id="inputVerificationCode" required maxlength="6" minlength="6" class="w-full text-sm rounded-xl p-2.5 font-mono text-center tracking-widest input-custom" placeholder="000000">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Nueva Contraseña:</label>
            <input type="password" id="inputNewPassword" required minlength="4" class="w-full text-sm rounded-xl p-2.5 input-custom" placeholder="Mínimo 4 caracteres">
          </div>
          <button type="submit" class="w-full btn-green font-bold text-xs py-2.5 rounded-xl shadow-md">
            <i class="fa-solid fa-key mr-1.5 text-white"></i> Validar Código y Restablecer
          </button>
        </form>

        <div class="text-center pt-2">
          <a href="#" onclick="switchAuthTab('login')" class="text-xs text-gray-600 hover:text-green-800 font-bold">← Volver al Inicio de Sesión</a>
        </div>
      </div>

    </div>

    <!-- PLATAFORMA PRINCIPAL AUTENTICADA -->
    <div id="appSection" class="hidden space-y-6">

      <!-- 1. MÓDULO ESTUDIANTE -->
      <div id="panel-estudiante" class="role-panel hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
          <h3 class="text-base font-bold text-gray-800 mb-4 flex items-center">
            <i class="fa-solid fa-cloud-arrow-up text-green-700 mr-2 text-lg"></i> Envío de Documentos de Trabajo de Grado
          </h3>
          <div id="studentDeadlineAlert" class="mb-4 p-3.5 rounded-xl text-xs border font-bold"></div>
          
          <form onsubmit="submitSubmission(event)" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Título de la Entrega / Avance</label>
                <input type="text" id="subTitle" required placeholder="Ej: Documento Final para Evaluación de Jurados" class="w-full text-sm rounded-xl p-2.5 input-custom">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Destinatario del Envío</label>
                <select id="subTarget" required class="w-full text-sm rounded-xl p-2.5 input-custom bg-white">
                  <option value="director">Director (Para revisión/aval)</option>
                  <option value="jurado">Jurado (Para dictamen/calificación)</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Adjuntar Trabajo (PDF, Word, ZIP, etc.)</label>
              <input type="file" id="subFile" required class="block w-full text-sm text-gray-700 border border-gray-400 rounded-xl bg-slate-50 p-2.5 cursor-pointer">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Comentarios u Observaciones del Estudiante</label>
              <textarea id="subNotes" rows="2" class="w-full text-sm rounded-xl p-2.5 input-custom" placeholder="Resumen metodológico o aclaraciones sobre el archivo adjunto..."></textarea>
            </div>
            <button type="submit" class="btn-green font-bold text-sm px-5 py-2.5 rounded-xl shadow-md flex items-center gap-2">
              <i class="fa-solid fa-paper-plane text-white"></i> Registrar Envío
            </button>
          </form>
        </div>
      </div>

      <!-- 2. MÓDULO REVISOR (DIRECTOR / JURADO) -->
      <div id="panel-revisor" class="role-panel hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
          <h3 id="revisorTitle" class="text-base font-bold text-gray-800 mb-1 flex items-center"></h3>
          <p id="revisorSubtitle" class="text-xs text-gray-600 mb-5"></p>

          <div class="overflow-x-auto mb-6 rounded-xl border border-gray-200">
            <table class="min-w-full text-xs text-left text-gray-700">
              <thead class="bg-gray-100 text-gray-800 font-bold border-b border-gray-300">
                <tr>
                  <th class="py-3 px-4">Fecha Envío</th>
                  <th class="py-3 px-4">Estudiante</th>
                  <th class="py-3 px-4">Documento / Archivo</th>
                  <th class="py-3 px-4">Oportunidad</th>
                  <th class="py-3 px-4">Estado / Nota</th>
                  <th class="py-3 px-4 text-right">Acción</th>
                </tr>
              </thead>
              <tbody id="revisorSubmissionsTable" class="divide-y divide-gray-200"></tbody>
            </table>
          </div>

          <div id="feedbackFormContainer" class="hidden bg-green-50 border border-green-300 rounded-2xl p-5 shadow-sm">
            <h4 class="text-sm font-bold text-green-900 mb-3 flex items-center">
              <i class="fa-solid fa-clipboard-check mr-2 text-green-700"></i> Emitir Valoración para: <span id="feedbackTargetTitle" class="ml-1 underline"></span>
            </h4>
            
            <form onsubmit="submitFeedback(event)" class="space-y-3.5">
              <input type="hidden" id="feedbackSubId">
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Concepto / Dictamen</label>
                  <select id="feedbackDecision" required class="w-full text-xs rounded-xl p-2.5 bg-white input-custom"></select>
                </div>

                <div id="gradeFieldContainer">
                  <label class="block text-xs font-bold text-gray-700 mb-1">Calificación Definitiva (0.0 - 5.0)</label>
                  <input type="number" id="feedbackGrade" step="0.1" min="0" max="5" placeholder="Ej: 4.8" class="w-full text-xs rounded-xl p-2.5 bg-white input-custom">
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Adjuntar Correcciones / Acta</label>
                  <input type="file" id="feedbackFile" class="block w-full text-xs text-gray-700 border border-gray-300 rounded-xl cursor-pointer bg-white p-2">
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Justificación Técnica / Observaciones Académicas</label>
                <textarea id="feedbackText" required rows="3" class="w-full text-sm rounded-xl p-2.5 input-custom" placeholder="Escriba aquí los comentarios detallados o correcciones solicitadas..."></textarea>
              </div>

              <div class="flex gap-2.5 pt-1">
                <button type="submit" class="btn-green font-bold text-xs px-4 py-2 rounded-xl shadow">
                  Guardar y Notificar
                </button>
                <button type="button" onclick="closeFeedbackForm()" class="bg-gray-500 hover:bg-gray-600 text-white font-bold text-xs px-4 py-2 rounded-xl">
                  Cancelar
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- 3. MÓDULO COORDINADOR DE ÉNFASIS -->
      <div id="panel-coordinador" class="role-panel hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
          <h3 class="text-base font-bold text-gray-800 mb-3 flex items-center">
            <i class="fa-solid fa-business-time text-green-700 mr-2 text-lg"></i> Ajustar Plazo Oficial de Entregas (Límite Global)
          </h3>
          <form onsubmit="setDeadline(event)" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="w-full sm:w-auto">
              <label class="block text-xs font-bold text-gray-700 mb-1">Fecha y Hora Límite</label>
              <input type="datetime-local" id="deadlineInput" required class="text-sm rounded-xl p-2.5 bg-white w-full input-custom">
            </div>
            <button type="submit" class="btn-green font-bold text-xs px-5 py-3 rounded-xl shadow">Actualizar Límite</button>
          </form>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
          <h3 class="text-base font-bold text-gray-800 mb-3 flex items-center">
            <i class="fa-solid fa-users text-green-700 mr-2 text-lg"></i> Directorio de Usuarios y Roles Registrados
          </h3>
          <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="min-w-full text-xs text-left text-gray-700">
              <thead class="bg-gray-100 text-gray-800 font-bold border-b border-gray-300">
                <tr>
                  <th class="py-2.5 px-4">Nombre</th>
                  <th class="py-2.5 px-4">Usuario</th>
                  <th class="py-2.5 px-4">Correo Institucional</th>
                  <th class="py-2.5 px-4">Rol Asignado</th>
                </tr>
              </thead>
              <tbody id="registeredUsersTable" class="divide-y divide-gray-200"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 4. HISTORIAL GENERAL -->
      <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6 mt-6">
        <h3 class="text-base font-bold text-gray-800 mb-4 flex items-center">
          <i class="fa-solid fa-clock-rotate-left text-green-700 mr-2 text-lg"></i> Trazabilidad Completa y Libro de Calificaciones
        </h3>
        <div class="overflow-x-auto rounded-xl border border-gray-200">
          <table class="min-w-full text-xs text-left text-gray-700">
            <thead class="bg-gray-100 text-gray-800 font-bold border-b border-gray-300">
              <tr>
                <th class="py-3 px-4">Fecha</th>
                <th class="py-3 px-4">Estudiante</th>
                <th class="py-3 px-4">Evaluador / Rol</th>
                <th class="py-3 px-4">Detalle Trabajo</th>
                <th class="py-3 px-4">Plazo</th>
                <th class="py-3 px-4">Nota Jurado</th>
                <th class="py-3 px-4">Concepto Emitido</th>
              </tr>
            </thead>
            <tbody id="historyTable" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <footer class="bg-gray-900 text-gray-300 text-xs py-5 mt-auto border-t border-gray-800 text-center">
    <p class="font-bold">Sistema de Gestión de Trabajos de Grado — Universidad del Quindío</p>
  </footer>

  <script>
    const API_URL = 'http://localhost:3000/api';

    let activeResetUser = null;
    let validVerificationCode = null;

    function getUsers() { return JSON.parse(localStorage.getItem('system_users')) || []; }
    function saveUsers(users) { localStorage.setItem('system_users', JSON.stringify(users)); }
    function getCurrentUser() { return JSON.parse(localStorage.getItem('current_session')); }
    function setCurrentUser(user) { localStorage.setItem('current_session', JSON.stringify(user)); }
    function getSubmissions() { return JSON.parse(localStorage.getItem('system_submissions')) || []; }
    function saveSubmissions(subs) { localStorage.setItem('system_submissions', JSON.stringify(subs)); }
    function getDeadline() { return localStorage.getItem('system_deadline') || null; }
    function saveDeadline(deadline) { localStorage.setItem('system_deadline', deadline); }

    function logout() {
      localStorage.removeItem('current_session');
      document.querySelectorAll('form').forEach(f => f.reset());

      activeResetUser = null;
      validVerificationCode = null;

      document.getElementById('codeNotification')?.classList.add('hidden');
      document.getElementById('verifyCodeForm')?.classList.add('hidden');

      switchAuthTab('login');
      renderApp();
    }

    function switchAuthTab(tab) {
      const loginForm = document.getElementById('loginForm');
      const registerForm = document.getElementById('registerForm');
      const forgotContainer = document.getElementById('forgotFormContainer');
      const authTabs = document.getElementById('authTabs');

      document.querySelectorAll('form').forEach(f => f.reset());
      document.getElementById('codeNotification')?.classList.add('hidden');
      document.getElementById('verifyCodeForm')?.classList.add('hidden');

      if (tab === 'login') {
        authTabs.classList.remove('hidden');
        loginForm.classList.remove('hidden');
        registerForm.classList.add('hidden');
        forgotContainer.classList.add('hidden');
        document.getElementById('tabLogin').className = "w-1/2 py-2.5 border-b-2 border-green-700 text-green-800 font-extrabold focus:outline-none";
        document.getElementById('tabRegister').className = "w-1/2 py-2.5 border-b-2 border-transparent text-gray-500 hover:text-green-700 font-bold focus:outline-none";
      } else if (tab === 'register') {
        authTabs.classList.remove('hidden');
        loginForm.classList.add('hidden');
        registerForm.classList.remove('hidden');
        forgotContainer.classList.add('hidden');
        document.getElementById('tabRegister').className = "w-1/2 py-2.5 border-b-2 border-green-700 text-green-800 font-extrabold focus:outline-none";
        document.getElementById('tabLogin').className = "w-1/2 py-2.5 border-b-2 border-transparent text-gray-500 hover:text-green-700 font-bold focus:outline-none";
      } else if (tab === 'forgot') {
        authTabs.classList.add('hidden');
        loginForm.classList.add('hidden');
        registerForm.classList.add('hidden');
        forgotContainer.classList.remove('hidden');
      }
    }

    function checkIsOnTime() {
      const deadline = getDeadline();
      if (!deadline) return true;
      return new Date() <= new Date(deadline);
    }

    function setDeadline(e) {
      e.preventDefault();
      saveDeadline(document.getElementById('deadlineInput').value);
      alert('Plazo oficial actualizado correctamente.');
      renderApp();
    }

    async function handleRegister(e) {
      e.preventDefault();
      const userData = {
        name: document.getElementById('regName').value.trim(),
        username: document.getElementById('regUsername').value.trim(),
        email: document.getElementById('regEmail').value.trim().toLowerCase(),
        password: document.getElementById('regPassword').value,
        role: document.getElementById('regRole').value
      };

      try {
        const response = await fetch(`${API_URL}/auth/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(userData)
        });
        const data = await response.json();

        if (response.ok) {
          alert('✅ ¡Registro exitoso! Por favor inicia sesión con tu usuario y contraseña.');
          document.getElementById('registerForm').reset();
          switchAuthTab('login');
        } else {
          alert(data.message || 'Error al registrar la cuenta.');
        }
      } catch (err) {
        let users = getUsers();
        if (users.some(u => u.email === userData.email || u.username.toLowerCase() === userData.username.toLowerCase())) {
          alert('❌ El correo o el nombre de usuario ya está registrado.');
          return;
        }
        users.push(userData);
        saveUsers(users);

        alert('✅ ¡Registro exitoso! Por favor ingresa tus credenciales para iniciar sesión.');
        document.getElementById('registerForm').reset();
        switchAuthTab('login');
      }
    }

    async function handleLogin(e) {
      e.preventDefault();
      const loginVal = document.getElementById('loginUser').value.trim().toLowerCase();
      const password = document.getElementById('loginPassword').value;

      try {
        const response = await fetch(`${API_URL}/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user: loginVal, password: password })
        });
        const data = await response.json();

        if (response.ok) {
          setCurrentUser(data.user);
          renderApp();
        } else {
          alert(data.message || 'Credenciales de acceso incorrectas.');
        }
      } catch (err) {
        const users = getUsers();
        const user = users.find(u => 
          (u.email && u.email.toLowerCase() === loginVal) || 
          (u.username && u.username.toLowerCase() === loginVal)
        );
        if (!user || user.password !== password) {
          alert('Nombre de usuario o contraseña incorrectos.');
          return;
        }
        setCurrentUser(user);
        renderApp();
      }
    }

    async function handleSendCode(e) {
      e.preventDefault();
      const accountInput = document.getElementById('resetAccountInput').value.trim().toLowerCase();
      const users = getUsers();

      const user = users.find(u => 
        (u.email && u.email.toLowerCase() === accountInput) || 
        (u.username && u.username.toLowerCase() === accountInput)
      );

      if (!user) {
        alert('❌ No existe ninguna cuenta registrada con esos datos.');
        return;
      }

      activeResetUser = user;
      validVerificationCode = Math.floor(100000 + Math.random() * 900000).toString();

      document.getElementById('targetEmailDisplay').textContent = user.email;
      document.getElementById('generatedCodeDisplay').textContent = validVerificationCode;
      document.getElementById('codeNotification').classList.remove('hidden');
      document.getElementById('verifyCodeForm').classList.remove('hidden');

      alert(`📩 Código de verificación enviado al correo: ${user.email}`);
    }

    async function handleResetPassword(e) {
      e.preventDefault();
      const inputCode = document.getElementById('inputVerificationCode').value.trim();
      const newPassword = document.getElementById('inputNewPassword').value;

      if (!validVerificationCode || inputCode !== validVerificationCode) {
        alert('❌ CÓDIGO INCORRECTO: El código de 6 dígitos ingresado no es válido.');
        document.getElementById('inputVerificationCode').value = '';
        document.getElementById('inputVerificationCode').focus();
        return;
      }

      try {
        await fetch(`${API_URL}/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: activeResetUser.email, code: inputCode, newPassword })
        });
      } catch (err) {
        let users = getUsers();
        const index = users.findIndex(u => u.email === activeResetUser.email);
        if (index !== -1) {
          users[index].password = newPassword;
          saveUsers(users);
        }
      }

      alert('✅ ¡Contraseña restablecida con éxito! Inicia sesión con tu nueva clave.');
      logout();
    }

    async function submitSubmission(e) {
      e.preventDefault();
      const user = getCurrentUser();
      const title = document.getElementById('subTitle').value;
      const target = document.getElementById('subTarget').value;
      const notes = document.getElementById('subNotes').value;
      const fileInput = document.getElementById('subFile');
      const fileObj = fileInput.files[0];
      const fileName = fileObj ? fileObj.name : 'archivo_sin_nombre';
      const fileUrl = fileObj ? URL.createObjectURL(fileObj) : '#';
      const isOnTime = checkIsOnTime();

      const formData = new FormData();
      formData.append('title', title);
      formData.append('targetRole', target);
      formData.append('notes', notes);
      formData.append('studentName', user.name);
      formData.append('file', fileObj);

      try {
        await fetch(`${API_URL}/submissions`, { method: 'POST', body: formData });
      } catch (err) {
        const newSub = {
          id: Date.now(),
          date: new Date().toLocaleDateString('es-CO') + ' ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
          studentName: user.name,
          studentEmail: user.email,
          title: title,
          targetRole: target,
          fileName: fileName,
          fileUrl: fileUrl,
          notes: notes,
          isOnTime: isOnTime,
          status: 'Pendiente de Revisión',
          grade: null,
          feedback: null
        };
        let subs = getSubmissions();
        subs.push(newSub);
        saveSubmissions(subs);
      }

      alert('Documento enviado correctamente.');
      document.getElementById('subTitle').value = '';
      document.getElementById('subNotes').value = '';
      fileInput.value = '';
      renderApp();
    }

    function openFeedbackForm(subId) {
      const user = getCurrentUser();
      const subs = getSubmissions();
      const sub = subs.find(s => s.id === subId);
      if (!sub) return;

      document.getElementById('feedbackSubId').value = sub.id;
      document.getElementById('feedbackTargetTitle').textContent = `${sub.title} (${sub.studentName})`;

      const decisionSelect = document.getElementById('feedbackDecision');
      const gradeContainer = document.getElementById('gradeFieldContainer');

      if (user.role === 'director') {
        gradeContainer.classList.add('hidden');
        document.getElementById('feedbackGrade').required = false;
        decisionSelect.innerHTML = `
          <option value="Aprobado para Envío a Jurados">Aprobado para Envío a Jurados</option>
          <option value="Requiere Ajustes Metodológicos">Requiere Ajustes Metodológicos</option>
          <option value="Rechazado por el Director">Rechazado por el Director</option>
        `;
      } else if (user.role === 'jurado') {
        gradeContainer.classList.remove('hidden');
        document.getElementById('feedbackGrade').required = true;
        decisionSelect.innerHTML = `
          <option value="Aprobado Sobresaliente">Aprobado Sobresaliente</option>
          <option value="Aprobado">Aprobado</option>
          <option value="Aprobado con Condiciones">Aprobado con Condiciones</option>
          <option value="Reprobado">Reprobado</option>
        `;
      }

      document.getElementById('feedbackFormContainer').classList.remove('hidden');
    }

    function closeFeedbackForm() {
      document.getElementById('feedbackFormContainer').classList.add('hidden');
    }

    function submitFeedback(e) {
      e.preventDefault();
      const subId = parseInt(document.getElementById('feedbackSubId').value);
      const decision = document.getElementById('feedbackDecision').value;
      const gradeInput = document.getElementById('feedbackGrade').value;
      const feedbackText = document.getElementById('feedbackText').value;
      const fileInput = document.getElementById('feedbackFile');
      const feedbackFileName = fileInput.files[0] ? fileInput.files[0].name : null;
      const feedbackFileUrl = fileInput.files[0] ? URL.createObjectURL(fileInput.files[0]) : null;
      const user = getCurrentUser();

      let subs = getSubmissions();
      const index = subs.findIndex(s => s.id === subId);

      if (index !== -1) {
        subs[index].status = decision;
        if (user.role === 'jurado' && gradeInput) {
          subs[index].grade = parseFloat(gradeInput).toFixed(1);
        }
        subs[index].feedback = {
          reviewerName: user.name,
          reviewerRole: user.role === 'director' ? 'Director' : 'Jurado',
          date: new Date().toLocaleDateString('es-CO') + ' ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
          comment: feedbackText,
          fileName: feedbackFileName,
          fileUrl: feedbackFileUrl
        };
        saveSubmissions(subs);
        alert('Valoración guardada y registrada en el historial.');
        closeFeedbackForm();
        renderApp();
      }
    }

    function renderApp() {
      const user = getCurrentUser();
      const deadline = getDeadline();
      document.getElementById('deadlineDisplay').textContent = deadline ? new Date(deadline).toLocaleString('es-CO') : "Sin definir";

      if (!user) {
        document.getElementById('authSection').classList.remove('hidden');
        document.getElementById('appSection').classList.add('hidden');
        document.getElementById('sessionArea').innerHTML = `<span class="text-white font-bold"><i class="fa-solid fa-user-slash mr-1"></i> No autenticado</span>`;
        document.getElementById('roleBadge').innerHTML = `<i class="fa-solid fa-circle-user text-yellow-400"></i> Estado: No autenticado`;
        return;
      }

      document.getElementById('authSection').classList.add('hidden');
      document.getElementById('appSection').classList.remove('hidden');

      const roleNames = {
        'estudiante': 'Estudiante (Autor de Proyecto)',
        'director': 'Director',
        'jurado': 'Jurado',
        'coordinador': 'Coordinador de Énfasis'
      };

      document.getElementById('sessionArea').innerHTML = `
        <span class="font-bold text-white flex items-center gap-1.5"><i class="fa-solid fa-circle-user text-yellow-300 text-sm"></i> ${user.name} <span class="text-green-200 text-[11px] font-normal">(${user.username})</span></span>
        <button onclick="logout()" class="bg-red-600 hover:bg-red-700 active:scale-95 px-3 py-1 rounded-xl text-white font-bold transition shadow-sm ml-2 flex items-center gap-1">
          <i class="fa-solid fa-power-off text-[10px]"></i> Salir
        </button>
      `;

      document.getElementById('roleBadge').innerHTML = `<i class="fa-solid fa-user-check text-green-300"></i> Rol Activo: ${roleNames[user.role]}`;
      document.querySelectorAll('.role-panel').forEach(p => p.classList.add('hidden'));

      if (user.role === 'estudiante') {
        document.getElementById('panel-estudiante').classList.remove('hidden');
        const isOnTime = checkIsOnTime();
        document.getElementById('studentDeadlineAlert').className = `mb-4 p-3.5 rounded-xl text-xs border font-bold ${isOnTime ? 'bg-green-100 border-green-300 text-green-900' : 'bg-red-100 border-red-300 text-red-900'}`;
        document.getElementById('studentDeadlineAlert').innerHTML = isOnTime ? 
          `<i class="fa-solid fa-circle-check mr-1.5 text-green-700"></i> Plazo activo para el registro de entregas.` : 
          `<i class="fa-solid fa-triangle-exclamation mr-1.5 text-red-700"></i> El plazo límite expiró. Tus envíos quedarán registrados automáticamente como tardíos.`;
      } else if (user.role === 'director' || user.role === 'jurado') {
        document.getElementById('panel-revisor').classList.remove('hidden');
        if (user.role === 'director') {
          document.getElementById('revisorTitle').innerHTML = `<i class="fa-solid fa-user-check text-green-700 mr-2"></i> Panel de Orientación (Director)`;
          document.getElementById('revisorSubtitle').textContent = "Revise los avances de sus estudiantes orientados y emita el aval metodológico para paso a jurados.";
        } else {
          document.getElementById('revisorTitle').innerHTML = `<i class="fa-solid fa-gavel text-green-700 mr-2"></i> Panel de Evaluación y Calificación (Jurado)`;
          document.getElementById('revisorSubtitle').textContent = "Evalúe los trabajos finales asignados, asigne la nota cuantitativa (0.0 - 5.0) y emita el dictamen final.";
        }
        renderRevisorSubmissions(user.role);
      } else if (user.role === 'coordinador') {
        document.getElementById('panel-coordinador').classList.remove('hidden');
        renderUserTable();
      }

      renderHistoryTable();
    }

    function renderRevisorSubmissions(role) {
      const subs = getSubmissions().filter(s => s.targetRole === role);
      const tableBody = document.getElementById('revisorSubmissionsTable');

      if (subs.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-gray-500 font-bold">No hay documentos asignados a su rol en este momento.</td></tr>`;
        return;
      }

      tableBody.innerHTML = subs.map(s => `
        <tr class="hover:bg-gray-50 transition">
          <td class="py-3 px-4">${s.date}</td>
          <td class="py-3 px-4 font-bold text-gray-900">${s.studentName}</td>
          <td class="py-3 px-4">
            <p class="font-bold text-gray-900">${s.title}</p>
            <a href="${s.fileUrl || '#'}" download="${s.fileName}" class="text-[11px] font-mono text-green-700 hover:underline inline-flex items-center gap-1 font-bold">
              <i class="fa-solid fa-paperclip"></i> ${s.fileName} <i class="fa-solid fa-download text-[9px] ml-0.5"></i>
            </a>
          </td>
          <td class="py-3 px-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${s.isOnTime ? 'bg-green-100 text-green-900 border border-green-300' : 'bg-red-100 text-red-900 border border-red-300'}">
              ${s.isOnTime ? 'A Tiempo' : 'Tardía'}
            </span>
          </td>
          <td class="py-3 px-4">
            <p class="font-bold text-xs text-gray-900">${s.status}</p>
            ${s.grade ? `<span class="text-xs font-bold text-green-700">Nota: ${s.grade}</span>` : ''}
          </td>
          <td class="py-3 px-4 text-right">
            <button onclick="openFeedbackForm(${s.id})" class="btn-green font-bold text-[11px] px-3 py-1.5 rounded-lg shadow-sm">
              <i class="fa-solid fa-pen-to-square mr-1 text-white"></i> ${role === 'director' ? 'Revisar / Avalar' : 'Evaluar y Calificar'}
            </button>
          </td>
        </tr>
      `).join('');
    }

    function renderHistoryTable() {
      const subs = getSubmissions();
      const tableBody = document.getElementById('historyTable');

      if (subs.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="7" class="py-4 text-center text-gray-500 font-bold">No hay registros en el historial.</td></tr>`;
        return;
      }

      tableBody.innerHTML = subs.map(s => `
        <tr class="hover:bg-gray-50 transition">
          <td class="py-3 px-4">${s.date}</td>
          <td class="py-3 px-4 font-bold text-gray-900">${s.studentName}</td>
          <td class="py-3 px-4 capitalize"><span class="bg-gray-200 text-gray-900 px-2 py-0.5 rounded border text-[11px] font-bold">${s.targetRole}</span></td>
          <td class="py-3 px-4">
            <p class="font-bold text-gray-900">${s.title}</p>
            <a href="${s.fileUrl || '#'}" download="${s.fileName}" class="text-[11px] font-mono text-green-700 hover:underline inline-flex items-center gap-1 font-bold">
              <i class="fa-solid fa-paperclip"></i> ${s.fileName} <i class="fa-solid fa-download text-[9px]"></i>
            </a>
          </td>
          <td class="py-3 px-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${s.isOnTime ? 'bg-green-100 text-green-900 border border-green-300' : 'bg-red-100 text-red-900 border border-red-300'}">
              ${s.isOnTime ? 'A Tiempo' : 'Tardía'}
            </span>
          </td>
          <td class="py-3 px-4 font-bold text-sm ${s.grade >= 3.5 ? 'text-green-700' : 'text-red-600'}">
            ${s.grade ? s.grade : '—'}
          </td>
          <td class="py-3 px-4">
            <span class="font-bold text-xs text-gray-900">${s.status}</span>
            ${s.feedback ? `
              <div class="bg-green-50 p-2.5 rounded-xl border border-green-300 mt-1.5 shadow-sm text-xs">
                <p class="font-bold text-green-900">${s.feedback.reviewerName} (${s.feedback.reviewerRole}):</p>
                <p class="text-gray-800 mt-0.5">${s.feedback.comment}</p>${s.feedback.fileName ? `<a href="${s.feedback.fileUrl || '#'}" download="${s.feedback.fileName}" class="mt-1 text-[11px] font-mono text-green-900 hover:underline inline-flex items-center gap-1 font-bold"><i class="fa-solid fa-file-export"></i> Adjunto: ${s.feedback.fileName}</a>` : ''}
              </div>
            ` : ''}
          </td>
        </tr>
      `).join('');
    }

    function renderUserTable() {
      const users = getUsers();
      document.getElementById('registeredUsersTable').innerHTML = users.map(u => `
        <tr class="hover:bg-gray-50 transition">
          <td class="py-2.5 px-4 font-bold text-gray-900">${u.name}</td>
          <td class="py-2.5 px-4 font-mono text-green-800 font-bold">${u.username || '—'}</td>
          <td class="py-2.5 px-4">${u.email}</td>
          <td class="py-2.5 px-4 capitalize"><span class="bg-gray-200 text-gray-900 px-2 py-0.5 rounded border text-[11px] font-bold">${u.role}</span></td>
        </tr>
      `).join('');
    }

    document.addEventListener('DOMContentLoaded', renderApp);
  </script>
</body>
</html>